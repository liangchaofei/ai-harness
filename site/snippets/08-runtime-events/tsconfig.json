{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "examples/**/*.ts"
  ],
  "exclude": [
    "**/dist",
    "node_modules",
    "site"
  ]
}
